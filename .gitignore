.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.env
wandb/
data/*
!data/LICENSES.md
runs/
*.onnx
!web/public/models/*.onnx
*.ckpt
*.pt
node_modules/
web/dist/
.DS_Store
# raw per-model benchmark outputs (tens of MB; regenerate with `make bench S=<suite>`);
# only the aggregated summary.json per suite is committed
results/*/*.json
!results/*/summary.json
!results/export/*.json
# study: raw per-model outputs ignored; summaries, tables and run index committed
results/study/*/*/*.json
!results/study/*/*/summary.json

# Timestral-distilled students: not released until the owner decides (docs/status.yaml clean-retrain)
web/public/models/clite_*
web/public/models/c2_*

# separate env for IBM TTM (granite-tsfm pins torch/pandas versions that clash with ours)
.venv-ttm/

# third-party repos and envs (GIFT-Eval harness)
external/
.venv-gift/
web/public/models/c3_*
.venv-gift-toto/
web/public/models/c4_*
web/public/models/c5_*
web/public/models/c6_*
web/public/models/c7_*
web/public/models/c8_*
web/public/models/c9_*
