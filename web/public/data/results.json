el":"ttm-r2.1-l1","rel_wql":0.8841637695318783,"ci":[0.803068425969192,0.9684980647405936],"cov80":0.0,"n_params":855100,"ms":1.3215410290285945,"label":"TTM-R2.1","role":"comparator"},{"model":"ttm-r2","rel_wql":0.9730120205777204,"ci":[0.9167989443791442,1.0226900651649133],"cov80":0.0,"n_params":805280,"ms":1.2611874844878912,"label":"TTM-R2","role":"comparator"},{"model":"seasonal_naive","rel_wql":1.0,"ci":[1.0,1.0],"cov80":0.8127446166666668,"n_params":0,"ms":0.05095801316201687,"label":"Seasonal naive","role":"baseline"},{"model":"ets","rel_wql":1.2196670845607764,"ci":[1.143315551296107,1.2997476167404498],"cov80":0.86434465,"n_params":0,"ms":258.31591605674475,"label":"ETS","role":"baseline"}],"n_windows":600,"n_series":425,"source":["results/multidomain_test/summary.json","results/study/stage_c3/table.json","results/study/stage_c_lite/table.json"]}},"gift":{"n_configs":55,"rank":144,"n_models":171,"rows":[{"model":"Timestral-28M","label":"Timestral-28M","crps":0.47805591340584686,"mase":0.6524369227537538,"role":"comparator"},{"model":"Toto-2.0-313m","label":"Toto-2.0-313m (teacher)","crps":0.49312969265546447,"mase":0.6706367816146306,"role":"teacher"},{"model":"Chronos-2","label":"Chronos-2","crps":0.4961606074790837,"mase":0.6666071079008454,"role":"comparator"},{"model":"Toto-2.0-22m","label":"Toto-2.0-22m","crps":0.5083923976727412,"mase":0.686650221246745,"role":"comparator"},{"model":"Toto-2.0-4m","label":"Toto-2.0-4m","crps":0.5273974882898903,"mase":0.7139164643423729,"role":"comparator"},{"model":"chronos_bolt_small","label":"Chronos-Bolt-small","crps":0.5431815194776725,"mase":0.7415652501064829,"role":"comparator"},{"model":"Toto-2.0-4m@512","label":"Toto-2.0-4m, 512 context like ours","role":"comparator","crps":0.5634140791035279,"mase":null},{"model":"tinycast-c3-kd_toto_1m","label":"Our student","crps":0.6272477024283242,"mase":0.8297885944725183,"role":"student"},{"model":"TTM-R2-Pretrained","label":"TTM-R2","crps":0.9388348115231201,"mase":1.004836805381401,"role":"comparator"},{"model":"Seasonal_Naive","label":"Seasonal naive","crps":1.0,"mase":1.0,"role":"baseline"}],"source":["results/gift_eval/summary.json","results/gift_eval/pairs.json"]},"findings":[{"group":"worth","title":"Better than Toto-2.0-4m, with 4\u00d7 fewer parameters","versus":"vs Toto-2.0-4m (4.1M), used as released","text":"Our 0.95M student against the smallest official Toto. Clear win on fresh electricity and the shapes; a tie on public data the Toto models may have seen in pretraining.","takeaway":"A small model trained on a big model's forecasts can beat a model of similar size trained from scratch by its authors.","contrasts":[{"suite":"fresh_fr_power","name":"Fresh electricity","ratio":[0.9235234461026353,0.8940820693986347,0.9513492884719055],"source":"results/study/stage_c3/table.json"},{"suite":"shapes","name":"Synthetic shapes","ratio":[0.868204338011284,0.839612876098101,0.8994048904946691],"source":"results/study/stage_c3/table.json"},{"suite":"multidomain_test","name":"Public data","ratio":[0.9943365056041166,0.9693542375801637,1.0204914581233344],"source":"results/study/stage_c3/table.json"}]},{"group":"worth","title":"Within 3\u20138% of the teacher it copies, at 330\u00d7 fewer parameters","versus":"vs its teacher, Toto-2.0-313m","text":"The student never beats its teacher (it is trained to imitate it), but it keeps most of its accuracy.","takeaway":"Expect the student to land a few percent behind the teacher, not above it.","contrasts":[{"suite":"fresh_fr_power","name":"Fresh electricity","ratio":[1.057454117042555,1.0326853463314491,1.0825993944265215],"source":"results/study/stage_c3/table.json"},{"suite":"shapes","name":"Synthetic shapes","ratio":[1.0265079053040524,1.003713238212751,1.0496489093279926],"source":"results/study/stage_c3/table.json"},{"suite":"multidomain_test","name":"Public data","ratio":[1.0745902041174855,1.0494179381939988,1.102493563054913],"source":"results/study/stage_c3/table.json"}]},{"group":"worth","title":"On GIFT-Eval it loses to Toto-2.0-4m","versus":"vs Toto-2.0-4m at the same 512-step context","text":"On 55 short-term GIFT-Eval configs our student is 11% worse than Toto-2.0-4m, even when Toto reads the same 512 steps. It wins on only 12 configs. The same-data student taught by Timestral lost most on 10-second, 10-minute and daily series, which our training windows barely cover.","takeaway":"Distillation transfers the teacher's skill only on inputs like those you distil on. Test on data outside your training domain before claiming generality.","contrasts":[{"suite":"gift","name":"GIFT-Eval (55 configs; better on 12)","ratio":[1.1132978846151034,1.0642817451144315,1.176694039625026],"source":"results/gift_eval/pairs.json"}]},{"group":"worth","title":"A student trained on the domain's own history ties it on that domain","versus":"distilled general student vs a same-size student trained on 12k French electricity windows","text":"On electricity, a student trained only on real electricity history (plus synthetic series) scores the same. On the shapes the distilled student has 20% lower error: it is the general one.","takeaway":"If you only forecast one domain and have its history, train on it first. Distil when you need one model for many domains.","contrasts":[{"suite":"fresh_fr_power","name":"Fresh electricity","ratio":[0.9984596188141943,0.9683308768431202,1.0274603032967828],"source":"results/site_pairs.json"},{"suite":"shapes","name":"Synthetic shapes","ratio":[0.7993588918031745,0.751602953192911,0.849132626450422],"source":"results/site_pairs.json"}]},{"group":"recipe","title":"Teacher forecasts are better labels than the real future","versus":"teacher labels vs real futures, same network, same 300k windows","text":"Only the training target changes: the teacher's 13 quantiles (Timestral-209M) instead of the one future that happened. The teacher's distribution is a less noisy target than a single draw.","takeaway":"With real inputs, train on the teacher's quantiles (\u03b1 = 1), not on the observed values.","contrasts":[{"suite":"fresh_fr_power","name":"Fresh electricity","ratio":[0.8789725209139065,0.8592669300754552,0.8980117310731698],"source":"results/study/stage_c_lite/table.json"},{"suite":"shapes","name":"Synthetic shapes","ratio":[0.8517908711691343,0.8189187215422689,0.8843514961963355],"source":"results/study/stage_c_lite/table.json"},{"suite":"multidomain_test","name":"Public data","ratio":[0.9640720241432483,0.9328240909471113,0.998752442369977],"source":"results/study/stage_c_lite/table.json"}]},{"group":"recipe","title":"More training windows is the biggest lever","versus":"300k windows vs 30k, same student and teacher","text":"No other change we tested (teacher, loss, student size) moved the score as much.","takeaway":"Spend your compute on labelling more windows before tuning anything else.","contrasts":[{"suite":"fresh_fr_power","name":"Fresh electricity","ratio":[0.8733439896858698,0.8384450346827116,0.911310647458716],"source":"results/study/stage_c_lite/table.json"},{"suite":"shapes","name":"Synthetic shapes","ratio":[0.7417383829177293,0.7025984706177503,0.7796008189041391],"source":"results/study/stage_c_lite/table.json"},{"suite":"multidomain_test","name":"Public data","ratio":[0.9065799745009621,0.8843169012185034,0.9284613463614961],"source":"results/study/stage_c_lite/table.json"}]},{"group":"recipe","title":"\u2026and it keeps paying off at 1M windows","versus":"1M windows (about 40 datasets) vs 300k","text":"Same student, labels from Timestral-28M. Gains on all three test sets, largest on the fresh electricity data.","takeaway":"If 300k windows helped, try 1M before changing the architecture.","contrasts":[{"suite":"fresh_fr_power","name":"Fresh electricity","ratio":[0.8935657073424772,0.8700958577881337,0.9158916903002952],"source":"results/study/stage_c2/table.json"},{"suite":"shapes","name":"Synthetic shapes","ratio":[0.9409028922598056,0.917378103323155,0.9639381629480871],"source":"results/study/stage_c2/table.json"},{"suite":"multidomain_test","name":"Public data","ratio":[0.9393837727144799,0.9169560042169894,0.9606592449204094],"source":"results/study/stage_c2/table.json"}]},{"group":"recipe","title":"At 1M windows, the choice of teacher barely matters","versus":"Toto-2.0-313m labels vs Timestral-28M labels, same 1M windows","text":"Between \u22123% and +3% depending on the test set. An ensemble of three teachers was no better either, although it won by 2% at 30k windows.","takeaway":"Pick the teacher with the cleanest licence and the cheapest inference; scale the data instead.","contrasts":[{"suite":"fresh_fr_power","name":"Fresh electricity","ratio":[0.969862172774643,0.9519454210352345,0.9888391592815315],"source":"results/study/stage_c3/table.json"},{"suite":"shapes","name":"Synthetic shapes","ratio":[0.985001466056144,0.9629252811190834,1.0077556424265475],"source":"results/study/stage_c3/table.json"},{"suite":"multidomain_test","name":"Public data","ratio":[1.0278827555148693,1.0092182663184013,1.0494605221881674],"source":"results/study/stage_c3/table.json"}]},{"group":"recipe","title":"Random noise as input teaches nothing","versus":"white-noise inputs vs KernelSynth inputs, both labelled by the teacher","text":"On noise, the teacher answers every input with the same flat forecast, so the student learns one flat forecast. Gaussian-process series (KernelSynth) make the teacher react to trend and seasonality.","takeaway":"Data-free distillation works only with structured synthetic inputs.","contrasts":[{"suite":"fresh_fr_power","name":"Fresh electricity","ratio":[1.4834351986706866,1.4098491803524829,1.569525884959015],"source":"results/study/stage_a/table.json"},{"suite":"shapes","name":"Synthetic shapes","ratio":[5.698063269098726,4.862364523094823,6.665776941098844],"source":"results/study/stage_a/table.json"},{"suite":"multidomain_test","name":"Public data","ratio":[1.4639287520686073,1.3655738923224336,1.5821186379849472],"source":"results/study/stage_a/table.json"}]},{"group":"recipe","title":"On synthetic inputs, the real future beats the teacher","versus":"teacher labels vs the generator's true future, synthetic inputs only","text":"When the generator knows the exact continuation, that continuation is a better target on the shapes than the teacher's guess; elsewhere it is a tie.","takeaway":"Distil where the truth is noisy (real data); use the generator's truth where it is exact.","contrasts":[{"suite":"fresh_fr_power","name":"Fresh electricity","ratio":[1.001929162644812,0.9884761279504365,1.0159857435287483],"source":"results/study/stage_a/table.json"},{"suite":"shapes","name":"Synthetic shapes","ratio":[1.123250183879091,1.095648586905045,1.152376172468225],"source":"results/study/stage_a/table.json"},{"suite":"multidomain_test","name":"Public data","ratio":[1.001877671572738,0.9891512983859501,1.0136292751318483],"source":"results/study/stage_a/table.json"}]},{"group":"ship","title":"int8 is free on electricity, costs 3% on shapes","versus":"int8 ONNX vs fp32 ONNX, same student","text":"Dynamic int8 with per-channel weights, patch embedding kept in fp32: 3.9 MB \u2192 1.3 MB.","takeaway":"Quantise, then re-run the benchmark: the parity error does not tell you the accuracy cost.","contrasts":[{"suite":"fresh_fr_power","name":"Fresh electricity","ratio":[1.000799585862957,0.9996566091178788,1.001955274488715],"source":"results/site_pairs.json"},{"suite":"shapes","name":"Synthetic shapes","ratio":[1.0320367468921634,1.0227546074598297,1.0418345448704385],"source":"results/site_pairs.json"}]},{"group":"ship","title":"Little history? Fine-tune from the distilled weights","versus":"fine-tune on 1 week of history: from distilled weights vs random weights (3 seeds)","text":"Measured with an earlier student (300k windows, Timestral-209M labels). On electricity, one week of data from random weights gives a model worse than seasonal naive.","takeaway":"Start every small-data fine-tune from the distilled checkpoint.","contrasts":[{"suite":"fresh_fr_power","name":"Fresh electricity","ratio":[0.5374458357153759,0.5100766142339969,0.5637627241421788],"source":"results/study/stage_d_final/table.json"}]},{"group":"ship","title":"With a full year of history, the head start is gone","versus":"fine-tune on 1 year: distilled weights vs random weights (3 seeds)","text":"Same earlier student. With enough in-domain data, training from scratch is as good or slightly better.","takeaway":"Distillation is worth most when your own data is scarce.","contrasts":[{"suite":"fresh_fr_power","name":"Fresh electricity","ratio":[1.0421117007892169,1.0145515580493103,1.0718193578348656],"source":"results/study/stage_d_final/table.json"}]}],"finetune":{"fresh_fr_power":{"zero_shot":0.7945696140081893,"curves":{"distilled":[{"amount":"1w","mean":0.7878100084668755,"min":0.7748270180577855,"max":0.8104444682601104},{"amount":"1m","mean":0.9071274337168228,"min":0.8811546863762748,"max":0.9274002581035498},{"amount":"1y","mean":0.6858506646984975,"min":0.6613264583269746,"max":0.7036119027538875}],"scratch":[{"amount":"1w","mean":1.469505103311122,"min":1.445868030485664,"max":1.4957245554425422},{"amount":"1m","mean":1.0902114817308108,"min":1.0675065915339859,"max":1.122434292633475},{"amount":"1y","mean":0.659908147051284,"min":0.6525640157369293,"max":0.6639217867458946}]},"source":"results/study/stage_d_final/table.json"},"pedestrian_test":{"zero_shot":0.7588843045551258,"curves":{"distilled":[{"amount":"1w","mean":0.6589590761845963,"min":0.6564404083931635,"max":0.6614957363246162},{"amount":"1m","mean":0.6185235919243949,"min":0.6153516705231656,"max":0.6212686950749255},{"amount":"1y","mean":0.5905396125286231,"min":0.5901855707640479,"max":0.5909083533703866}],"scratch":[{"amount":"1w","mean":0.678296417214329,"min":0.6731015493479091,"max":0.6848264621735882},{"amount":"1m","mean":0.6181074271444654,"min":0.6027877906285921,"max":0.6289016641927675},{"amount":"1