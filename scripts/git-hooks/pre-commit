#!/usr/bin/env bash
# The CI lint checks (.github/workflows/ci.yml), on the Python files being committed, plus a 5 MB size guard.
# Install once: `make hooks`. Checks staged files only, so someone's unfinished untracked file does not block a commit.
set -e
cd "$(git rev-parse --show-toplevel)"
py=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
if [ -n "$py" ]; then
  uv run --quiet ruff check $py || { echo "pre-commit: ruff check failed (try: uv run ruff check --fix <files>)"; exit 1; }
  uv run --quiet ruff format --check $py > /dev/null || { echo "pre-commit: run 'uv run ruff format <files>' first"; exit 1; }
fi
big=""
while IFS= read -r -d '' f; do
  [ -f "$f" ] || continue
  sz=$(wc -c < "$f")
  [ "$sz" -gt 5000000 ] && big="$big $f ($((sz / 1000000)) MB)"
done < <(git diff --cached --name-only --diff-filter=AM -z)
if [ -n "$big" ]; then echo "pre-commit: files over 5 MB staged:$big"; exit 1; fi
